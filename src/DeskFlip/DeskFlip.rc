#include <windows.h>
#include <winver.h>
#include "resource.h"

// The exe's identity plus four icons. The two menu bitmaps that used to live here went with the
// options dialog: the context menu's items carry check marks now, and a check mark and a per-item
// bitmap share the same gutter in a Win32 menu.
//
// Everything in the VERSIONINFO block comes from resource.h so the resource and the About box
// cannot drift apart.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    VER_NUMBER
    PRODUCTVERSION VER_NUMBER
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"                    // US English, Unicode
        BEGIN
            VALUE "CompanyName",      VER_COMPANY
            VALUE "FileDescription",  VER_DESCRIPTION
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     VER_PRODUCT
            VALUE "LegalCopyright",   VER_COPYRIGHT
            VALUE "OriginalFilename", VER_FILENAME
            VALUE "ProductName",      VER_PRODUCT
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200    // must match the block above
    END
END

// The app/tray icon, carried over from let-it-rain. It has the lowest id on purpose -- see
// resource.h.
IDI_DESKFLIP   ICON    "deskflip.ico"

// The About box's "Other apps" list. Each wraps a single 48x48 PNG frame taken from that app's
// own MSIX Square44x44Logo, kept as an icon rather than raw PNG data so LoadImageW can pick a
// frame for the monitor's DPI with no WIC decode of our own.
IDI_FLYPHOTOS   ICON    "res\\flyphotos.ico"
IDI_LETITRAIN   ICON    "res\\letitrain.ico"
IDI_DESKTICK    ICON    "res\\desktick.ico"
